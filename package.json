{
  "name": "smart-n-healthy-home",
  "version": "1.3.1",
  "main": "",
  "scripts": {
    "start": "node API/server/index.js",
    "dev": "nodemon API/server/index.js",
    "test": "jest --runInBand && node --test test/cookies.test.mjs",
    "test:coverage": "c8 --reporter=text jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --pretty false",
    "build": "node scripts/check.js",
    "capacitor:sync": "npx cap sync",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "House monitor for sensors, incidents and local services.",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.808.0",
    "@aws-sdk/client-dynamodb": "^3.808.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@google-cloud/storage": "^7.16.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "faceapi": "^1.0.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.13.0",
    "node-wifi": "^2.0.16",
    "nodemailer": "^10.2.1",
    "pino": "^9.14.0",
    "socket.io": "^4.8.1",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "^29.7.0",
    "c8": "^12.0.0",
    "eslint": "9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "typescript": "5.9.3"
  },
  "c8": {
    "include": [
      "API/server/domain/**/*.js",
      "API/server/validate.js",
      "API/server/log.js",
      "API/server/metrics.js",
      "API/server/http.js",
      "API/server/auth0/server/**/*.js",
      "API/Gemini/domain/**/*.js",
      "API/Accuweather/**/*.js"
    ],
    "reporter": [
      "text"
    ],
    "check-coverage": true,
    "lines": 70
  }
}
